diff --git a/src/webchat/readingContext.ts b/src/webchat/readingContext.ts
new file mode 100644
index 0000000..3e7d4f1
--- /dev/null
+++ b/src/webchat/readingContext.ts
@@ -0,0 +1,196 @@
+import { config } from "../../package.json";
+import type { PaperContextRef } from "../modules/contextPanel/types";
+import {
+  captureCurrentPdfPage,
+  getPdfViewerApplication,
+} from "../services/pdf/pdfPageCapture";
+import { getActiveReaderForSelectedTab } from "../services/pdf/zoteroReaderTabs";
+import { getFirstSelectionFromReader } from "../services/pdf/readerSelection";
+
+const BINDINGS_PREF = `${config.prefsPrefix}.webchatReadingBindings`;
+
+export type ReadingConversationBinding = {
+  paperIdentity: string;
+  chatUrl: string;
+  chatId: string | null;
+};
+
+export type WebChatReadingContext = {
+  paper: PaperContextRef;
+  paperIdentity: string;
+  image: string;
+  prompt: string;
+  assertCurrent: () => void;
+};
+
+function currentPageNumber(app: any): number {
+  const value = Number(app?.pdfViewer?.currentPageNumber || app?.page);
+  if (!Number.isSafeInteger(value) || value < 1) {
+    throw new Error(
+      "Cannot identify the current Zotero PDF page. Please wait for the page to load.",
+    );
+  }
+  return value;
+}
+
+function unwrapPdfObject(value: any): any {
+  try {
+    return value?.wrappedJSObject || value;
+  } catch {
+    return value;
+  }
+}
+
+async function readPageText(
+  pdfDocument: any,
+  pageNumber: number,
+): Promise<string> {
+  try {
+    const page = unwrapPdfObject(await pdfDocument.getPage(pageNumber));
+    if (typeof page?.getTextContent !== "function") return "";
+    const content = unwrapPdfObject(await page.getTextContent());
+    return Array.from(content?.items || [])
+      .map((entry) => String(unwrapPdfObject(entry)?.str || ""))
+      .join(" ")
+      .slice(0, 18000);
+  } catch {
+    // Some Zotero PDF.js wrappers expose rendering but not text extraction.
+    // The mandatory page image remains the source in that case.
+    return "";
+  }
+}
+
+/** Snapshot only the selected Zotero PDF, never another application or browser tab. */
+export async function captureWebChatReadingContext(): Promise<WebChatReadingContext | null> {
+  const reader = getActiveReaderForSelectedTab();
+  if (!reader) return null;
+  const attachmentId = Number(reader.itemID || reader._item?.id);
+  const attachment = Zotero.Items.get(attachmentId);
+  if (
+    !attachment?.isAttachment?.() ||
+    attachment.attachmentContentType !== "application/pdf"
+  ) {
+    return null;
+  }
+  const app = getPdfViewerApplication(reader);
+  if (!app?.pdfDocument) {
+    throw new Error(
+      "The current Zotero PDF is still loading. Please retry when its page is visible.",
+    );
+  }
+  const pageNumber = currentPageNumber(app);
+  const pdfDocument = unwrapPdfObject(app.pdfDocument);
+  const parent = attachment.parentID
+    ? Zotero.Items.get(attachment.parentID)
+    : attachment;
+  const title = String(
+    parent?.getField("title") ||
+      attachment.getField("title") ||
+      "Current Zotero PDF",
+  );
+  const fingerprints = pdfDocument.fingerprints || [
+    pdfDocument.fingerprint || "",
+  ];
+  const paperIdentity = `${attachment.libraryID}:${attachment.key}:${fingerprints.join(":")}`;
+  const assertCurrent = () => {
+    if (
+      getActiveReaderForSelectedTab() !== reader ||
+      currentPageNumber(app) !== pageNumber
+    ) {
+      throw new Error(
+        "The Zotero paper or page changed while preparing this question. Please send it again on the page you want to discuss.",
+      );
+    }
+  };
+  const selected = getFirstSelectionFromReader(reader, (text) => text.trim());
+  const text = await readPageText(pdfDocument, pageNumber);
+  const image = await captureCurrentPdfPage(reader, pageNumber);
+  if (!image) {
+    throw new Error(
+      "Could not capture the current Zotero PDF page. Please wait for it to render and retry.",
+    );
+  }
+  assertCurrent();
+  const label = String(app.pdfViewer?.currentPageLabel || pageNumber);
+  return {
+    paper: {
+      itemId: parent?.id || attachment.id,
+      contextItemId: attachment.id,
+      libraryID: attachment.libraryID,
+      title,
+      contentSourceMode: "pdf",
+    },
+    paperIdentity,
+    image,
+    assertCurrent,
+    prompt: [
+      "[Current Zotero reading context, captured when this question was sent]",
+      `Paper: ${title}`,
+      `PDF page: ${pageNumber} of ${pdfDocument.numPages}; displayed page label: ${label}.`,
+      "The attached page image is the current page of this Zotero PDF. Use this paper and page as the reading context. Browser tabs are unrelated. This is a page snapshot, not a continuous live screen stream.",
+      selected ? `Selected passage: ${selected}` : "",
+      text
+        ? `Current page text (possibly truncated):\n${text}`
+        : "Page text extraction is unavailable. Read the attached page image.",
+      "[End of reading context]",
+    ]
+      .filter(Boolean)
+      .join("\n\n"),
+  };
+}
+
+export function getReadingConversationBinding(
+  scope: string,
+): ReadingConversationBinding | null {
+  try {
+    const records = JSON.parse(
+      String(Zotero.Prefs.get(BINDINGS_PREF, true) || "{}"),
+    );
+    const value = records[scope];
+    return value &&
+      typeof value.paperIdentity === "string" &&
+      typeof value.chatUrl === "string" &&
+      value.chatUrl
+      ? value
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+export function saveReadingConversationBinding(
+  scope: string,
+  binding: ReadingConversationBinding,
+): void {
+  let records: Record<string, ReadingConversationBinding> = {};
+  try {
+    const parsed = JSON.parse(
+      String(Zotero.Prefs.get(BINDINGS_PREF, true) || "{}"),
+    );
+    if (parsed && typeof parsed === "object" && !Array.isArray(parsed))
+      records = parsed;
+  } catch {
+    /* A missing or corrupt cache must not prevent a verified answer from being saved. */
+  }
+  delete records[scope];
+  records[scope] = binding;
+  Zotero.Prefs.set(
+    BINDINGS_PREF,
+    JSON.stringify(Object.fromEntries(Object.entries(records).slice(-100))),
+    true,
+  );
+}
+
+export function readingBindingMatches(
+  binding: ReadingConversationBinding | null,
+  paperIdentity: string,
+  expectedUrl?: string | null,
+  expectedId?: string | null,
+): binding is ReadingConversationBinding {
+  return Boolean(
+    binding &&
+    binding.paperIdentity === paperIdentity &&
+    (!expectedUrl || expectedUrl === binding.chatUrl) &&
+    (!expectedId || expectedId === binding.chatId),
+  );
+}
