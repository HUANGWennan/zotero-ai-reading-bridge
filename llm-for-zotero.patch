+  async function preparePendingSend(verifiedBinding: boolean) {
+    const relay = await import("../src/webchat/relayServer");
+    const pipeline = await import("../src/webchat/pipeline");
+    relay.relayResetForTests();
+    relay.relaySetExtensionCapabilitiesForTests([
+      relay.ATTACHMENT_DELIVERY_CONTRACT_VERSION,
+    ]);
+    const previousSeq = relay.relayGetStateSnapshot().query.seq;
+    (globalThis as any).IOUtils = {
+      read: async () => new TextEncoder().encode("%PDF-current"),
+    };
+    if (verifiedBinding) {
+      saveReadingConversationBinding("1:PAPER_A:chatgpt", {
+        paperIdentity: "1:PDF_A:paper-a-fingerprint",
+        chatUrl: "https://chatgpt.com/c/verified-paper",
+        chatId: "verified-paper",
+      });
+    }
+    const send = pipeline.sendWebChatQuestion({
+      item: Zotero.Items.get(10),
+      question: "Explain this page",
+      host: "http://127.0.0.1:23119/llm-for-zotero/webchat",
+      target: "chatgpt",
+      onAnswerSnapshot: () => {},
+      ...(verifiedBinding
+        ? {}
+        : {
+            expectedChatUrl: "https://chatgpt.com/c/unrelated",
+            expectedChatId: "unrelated",
+          }),
+    });
+    void send.catch(() => {});
+    for (
+      let attempt = 0;
+      attempt < 30 && relay.relayGetStateSnapshot().query.seq === previousSeq;
+      attempt++
+    ) {
+      await new Promise((resolve) => setTimeout(resolve, 0));
+    }
+    return { relay, send, query: relay.relayGetStateSnapshot().query };
+  }
+
+  it("automatically uploads the current PDF into a fresh chat and never binds an unfinished send", async function () {
+    const { relay, send, query } = await preparePendingSend(false);
+    try {
+      assert.equal(query.pdf_filename, "current.pdf");
+      assert.isNotNull(query.pdf_base64);
+      assert.isTrue(query.force_new_chat);
+      assert.isNull(query.expected_chat_url);
+      assert.deepEqual(query.images, [image]);
+      assert.include(query.prompt, "PDF page: 4 of 30");
+      assert.isNull(getReadingConversationBinding("1:PAPER_A:chatgpt"));
+    } finally {
+      relay.relayRequestStop();
+      await send.catch(() => {});
+    }
+    assert.isNull(getReadingConversationBinding("1:PAPER_A:chatgpt"));
+  });
+
+  it("restores a verified paper conversation without uploading the PDF again", async function () {
+    const { relay, send, query } = await preparePendingSend(true);
+    try {
