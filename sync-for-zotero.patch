diff --git a/test/background_reading.test.mjs b/test/background_reading.test.mjs
new file mode 100644
index 0000000..987cd51
--- /dev/null
+++ b/test/background_reading.test.mjs
@@ -0,0 +1,79 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { createRequire } from "node:module";
+import test from "node:test";
+import vm from "node:vm";
+import { conversationFollowup } from "./helpers/conversation_workflow.mjs";
+
+const require = createRequire(import.meta.url);
+const shared = require("../extension/webchat_shared.js");
+
+test("a follow-up can submit from an inactive ChatGPT tab without selecting it", async () => {
+  const url = "https://chatgpt.com/c/11111111-2222-4333-8444-555555555555";
+  const h = conversationFollowup({ target: "chatgpt", expectedUrl: url, initialUrl: url, active: false });
+  await h.run({ prompt: "Selected passage: text\u0000 from the PDF\u0000." });
+  assert.deepEqual(h.errors, []);
+  assert.equal(h.sent[0]?.prompt, "Selected passage: text from the PDF.");
+  assert.equal(h.sent.length, 1);
+  assert.equal(h.tabUpdates.some((update) => update.active === true), false);
+  assert.equal(h.tabUpdates.some((update) => update.autoDiscardable === false), true);
+});
+
+test("background-rendered prefix uses the complete matching transport answer", () => {
+  assert.equal(shared.selectCompleteAnswerText("The paper argues", "The paper argues that institutions matter."), "The paper argues that institutions matter.");
+  assert.equal(shared.selectCompleteAnswerText("The paper\nargues", "The paper argues that institutions matter."), "The paper argues that institutions matter.");
+  assert.equal(shared.selectCompleteAnswerText("A different answer", "The paper argues that institutions matter."), "A different answer");
+  assert.equal(shared.selectCompleteAnswerText("The complete DOM answer", "The complete"), "The complete DOM answer");
+  assert.equal(shared.selectCompleteAnswerText("", "The complete stream answer"), "The complete stream answer");
+});
+
+test("concurrent heartbeat kicks share one probe and recover after a failure", async () => {
+  const source = fs.readFileSync(new URL("../extension/background.js", import.meta.url), "utf8");
+  const start = source.indexOf("let heartbeatInFlight = null;");
+  const end = source.indexOf("// Heartbeat: checks connectivity", start);
+  let count = 0;
+  let rejectProbe;
+  const context = vm.createContext({ checkHeartbeat: () => {
+    count++;
+    return new Promise((_resolve, reject) => { rejectProbe = reject; });
+  } });
+  vm.runInContext(source.slice(start, end), context);
+  const first = context.heartbeat();
+  assert.equal(context.heartbeat(), first);
+  assert.equal(count, 1);
+  rejectProbe(new Error("probe unavailable"));
+  await assert.rejects(first, /probe unavailable/);
+  const next = context.heartbeat();
+  assert.notEqual(next, first);
+  assert.equal(count, 2);
+  rejectProbe(new Error("probe unavailable"));
+  await assert.rejects(next, /probe unavailable/);
+});
+
+test("port rediscovery completes when initiated by an in-flight heartbeat", async () => {
+  const source = fs.readFileSync(new URL("../extension/background.js", import.meta.url), "utf8");
+  const start = source.indexOf("let _portDiscoveryInFlight = false;");
+  const end = source.indexOf("// Discover port on startup", start);
+  let requests = 0;
+  const context = vm.createContext({
+    SERVER: "http://localhost:23119/llm-for-zotero/webchat",
+    RELAY_HOSTS: ["127.0.0.1"],
+    HEARTBEAT_REQUEST_TIMEOUT_MS: 4000,
+    zoteroConnected: true,
+    console: { log() {} },
+    AbortSignal,
+    relayFetch: async (url) => {
+      requests++;
+      if (url.endsWith("/debug")) return { ok: true, json: async () => ({ status: "idle" }) };
+      return { ok: false };
+    },
+  });
+  const discovery = source.slice(start, end).replace(
+    /function resetExtensionState\(\) \{[\s\S]*?\n\}/,
+    "function resetExtensionState() {}",
+  );
+  vm.runInContext(discovery, context);
+  await context.heartbeat();
+  assert.equal(context.SERVER, "http://127.0.0.1:23119/llm-for-zotero/webchat");
+  assert.equal(requests, 2);
+});
diff --git a/test/helpers/content_source.mjs b/test/helpers/content_source.mjs
new file mode 100644
index 0000000..8522d7b
--- /dev/null
+++ b/test/helpers/content_source.mjs
@@ -0,0 +1,6 @@
+// White-box fixtures access content-script internals in their VM context.
+export function unwrapContentSource(source) {
+  const body = source.indexOf("// Utility helpers");
+  const end = source.lastIndexOf("globalThis.syncZoteroContentIsCurrent =");
+  return source.slice(body, end);
+}
